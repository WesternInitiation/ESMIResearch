# Copy to .env.local for local development, or set in the Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_BUCKET=esmi-images

# Private Cloud Run (recommended when org policy blocks allUsers).
# Server-only — the browser calls /api/compress; Vercel attaches an ID token.
COMPRESS_API_URL=https://esmi-compress-xxxxx-uc.a.run.app
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Large uploads (80–100+ MB): browser PUTs to GCS, Cloud Run reads gcs_uri.
GCS_UPLOAD_BUCKET=esmi-research-esmi-uploads

# Demo "Load demo data" button — signed reads from this bucket (defaults if unset).
GCS_DEMO_BUCKET=esmi-research-demo-data

# Legacy: public Cloud Run URL in the browser (only if allUsers invoker is allowed).
# Prefer COMPRESS_API_URL + GOOGLE_SERVICE_ACCOUNT_JSON instead.
# NEXT_PUBLIC_COMPRESS_API_URL=https://esmi-compress-xxxxx-uc.a.run.app

# Optional: anon key only if you intentionally use client-side Supabase.
# Prefer SUPABASE_SERVICE_ROLE_KEY (server-only) for the API routes.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
