# Copy to secrets.toml for local development, or paste into
# Streamlit Community Cloud → App settings → Secrets.
#
# Never commit real keys. service_role_key bypasses RLS and must stay server-side.

[supabase]
url = "https://YOUR_PROJECT.supabase.co"
service_role_key = "YOUR_SERVICE_ROLE_KEY"
bucket = "esmi-images"

# Optional: full public URL of the deployed app for copyable share links.
# Example: "https://esmi-research.streamlit.app"
app_base_url = "https://YOUR_APP.streamlit.app"
